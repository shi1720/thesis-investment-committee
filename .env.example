# Local Cloudflare preview: copy this file to .dev.vars (gitignored).
# Hosted deployment: set these via the hosting service's secret configuration.
# Never use real credentials in this tracked example.

# Meterless Nightshift is the only connected AI provider used by this application.
NIGHTSHIFT_BASE_URL=http://127.0.0.1:8088/v1
NIGHTSHIFT_API_KEY=YOUR_REAL_RUNTIME_PROXY_TOKEN
NIGHTSHIFT_MODEL=local-runtime/YOUR_CONCRETE_MODEL_ID
NIGHTSHIFT_TIMEOUT_MS=30000
# Optional independent exclusion auditor through Nightshift, e.g. a concrete Nemotron route.
NIGHTSHIFT_AUDITOR_MODEL=

# Zetaris API, not the Cloud Gateway sign-in website.
# Direct local Lightning example; proxy mode uses the origin without /api/v1.0.
ZETARIS_BASE_URL=http://127.0.0.1:8888/api/v1.0
ZETARIS_API_MODE=direct
ZETARIS_API_KEY=YOUR_READ_ONLY_ZETARIS_TOKEN
ZETARIS_ORG_ID=1
ZETARIS_STOCKS_VIEW=thesis.research_universe

# Explicit opt-in for a REAL Zetaris instance serving synthetic judge fixtures.
# Reports still say sample data. Set false for actual financial sources.
ZETARIS_ALLOW_SAMPLE_DATA=false

# NVIDIA provider keys belong in Nightshift's Providers settings, not this file.
# Laptop loopback services cannot be reached by a hosted Cloudflare Worker.
