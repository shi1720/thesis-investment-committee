# Portable API configuration. Copy into a private, ignored environment file.
# Cloud Run receives the encryption key through Secret Manager.
FIREBASE_PROJECT_ID=YOUR_FIREBASE_PROJECT_ID
FIRESTORE_DATABASE_ID=thesis-research
PUBLIC_ORIGINS=https://YOUR_HOSTING_SITE.web.app,https://YOUR_HOSTING_SITE.firebaseapp.com
THESIS_SETTINGS_KEY=YOUR_RANDOM_32_BYTE_BASE64URL_KEY
PLATFORM_V2=true
CLOUD_TASKS_LOCATION=us-central1
CLOUD_TASKS_QUEUE=thesis-research
CLOUD_RUN_SERVICE_URL=https://YOUR_SERVICE_URL
TASKS_INVOKER_SERVICE_ACCOUNT=YOUR_TASKS_SERVICE_ACCOUNT
# Optional explicitly selected operator route. Never expose a laptop admin port.
NIGHTSHIFT_BASE_URL=https://YOUR_NARROW_OPERATOR_GATEWAY/v1
NIGHTSHIFT_API_KEY=YOUR_OPERATOR_GATEWAY_TOKEN
# Personal NVIDIA/OpenAI/Anthropic/Gemini/search/market keys belong in app Settings.
# Local development only. Never enable this on the production service.
THESIS_LOCAL_JOBS=false

# Required primary financial-observation layer for a connected deployment
THESIS_ZETARIS_LAYER_URL=
THESIS_ZETARIS_LAYER_KEY=
THESIS_ZETARIS_LAYER_REQUIRED=true
# Explicit public filing snapshots retain their original dates, not live prices
THESIS_SEC_MODE=snapshot
